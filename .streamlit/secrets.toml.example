# Copy this file to secrets.toml and fill in your own keys.
# secrets.toml is gitignored; this example is committed so anyone cloning the
# repo can see which keys the app looks for without any being exposed.

GEMINI_API_KEY = "your-google-ai-studio-key"
GROQ_API_KEY = "your-groq-console-key"

# Optional. The app uses whichever of these are present, best headroom first.
# ANTHROPIC_API_KEY = "your-anthropic-key"
